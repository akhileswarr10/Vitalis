APP_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=30

# ---- Supabase (Postgres) ----
# Dashboard -> Connect -> copy the *pooler* connection string (works over IPv4), then use it as-is (scheme postgresql://) and keep TLS on
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres
# Tests/CI use an in-process Postgres (PGlite) and never read this file.
# NEVER put the DB password, service_role key or any Supabase secret in the frontend or in git.

# ---- Groq (hosted LLM, OpenAI-compatible API) ----
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
# Groq retires models regularly. The backend must verify LLM_MODEL against GET {GROQ_BASE_URL}/models at startup.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.2

# ---- NASA open API (DONKI space weather) ----
NASA_API_KEY=DEMO_KEY
SPACE_WEATHER_CACHE_MINUTES=30

# ---- Frontend ----
VITE_API_URL=http://localhost:8000
